{
  "expo": {
    "name": "Workout Planner",
    "slug": "workout-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workoutplanner",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "primaryColor": "#E9EBEE",
    "platforms": [
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.workoutplanner.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0A0A0C",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": []
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Workout Planner to access your photos so you can attach exercise and food images."
        }
      ],
      "expo-sqlite",
      "expo-system-ui",
      "expo-file-system",
      "expo-font"
    ]
  }
}
